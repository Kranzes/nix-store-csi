{
  "uid": "nix-store-csi",
  "title": "nix-store-csi",
  "description": "Publishes, NAR fetches, the node store and garbage collection of the nix-store-csi node plugins.",
  "tags": [
    "nix-store-csi",
    "csi"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(nix_store_csi_build_info, instance)",
        "query": {
          "query": "label_values(nix_store_csi_build_info, instance)",
          "refId": "instance"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Nodes",
      "description": "Node plugins that Prometheus scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(nix_store_csi_build_info{instance=~\"$instance\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed publishes",
      "description": "Publishes in the time range that failed with an error other than Unavailable. Unavailable means the plugin is still fetching the closure, and kubelet retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum ((last_over_time(nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\",grpc_code!~\"OK|Unavailable\"}[$__range]) - nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\",grpc_code!~\"OK|Unavailable\"} offset $__range >= 0) or last_over_time(nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\",grpc_code!~\"OK|Unavailable\"}[$__range])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Failed NAR fetches",
      "description": "NAR fetches in the time range that failed. The plugin then tries the next cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum ((last_over_time(nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\",result=\"error\"}[$__range]) - nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\",result=\"error\"} offset $__range >= 0) or last_over_time(nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\",result=\"error\"}[$__range])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Paused caches",
      "description": "Caches that a node skips for a minute after a failed request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (cache) (nix_store_csi_cache_paused{instance=~\"$instance\"}) == 1) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Store size",
      "description": "NAR size of the node stores, on all selected nodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(nix_store_csi_store_size_bytes{instance=~\"$instance\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Publishes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Publishes",
      "description": "NodePublishVolume calls by gRPC status code. Unavailable means the plugin was still fetching the closure after 90 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (grpc_code) ((nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\"} - nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\"} offset $__interval >= 0) or nix_store_csi_publish_duration_seconds_count{instance=~\"$instance\"})",
          "legendFormat": "{{grpc_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "lineWidth": 1,
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Publish time",
      "description": "Time from NodePublishVolume to a mounted volume, for publishes that succeeded. Fetching the closure is most of it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) ((nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"} - nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"} offset $__interval >= 0) or nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) ((nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"} - nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"} offset $__interval >= 0) or nix_store_csi_publish_duration_seconds_bucket{instance=~\"$instance\",grpc_code=\"OK\"}))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Closures in flight",
      "description": "Closures being resolved or fetched, by node. A closure counts until its fetches end, even after its publish returns Unavailable at 90 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (nix_store_csi_closures_in_flight{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Fetching",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "NAR throughput",
      "description": "Uncompressed NAR bytes fetched, by cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cache) ((nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"} - nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"} offset $__interval >= 0) or nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"}) / ($__interval_ms / 1000)",
          "legendFormat": "{{cache}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "NAR fetches",
      "description": "Tries at fetching a NAR, by cache and result.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cache, result) ((nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\"} - nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\"} offset $__interval >= 0) or nix_store_csi_nar_fetch_duration_seconds_count{instance=~\"$instance\"})",
          "legendFormat": "{{cache}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "lineWidth": 1,
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 13
    },
    {
      "type": "bargauge",
      "title": "Fetched by cache",
      "description": "Uncompressed NAR bytes that each cache served in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (cache) ((last_over_time(nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"}[$__range]) - nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"} offset $__range >= 0) or last_over_time(nix_store_csi_nar_fetched_bytes_total{instance=~\"$instance\"}[$__range])))",
          "legendFormat": "{{cache}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "id": 14
    },
    {
      "type": "heatmap",
      "title": "NAR fetch time",
      "description": "Successful NAR fetches by the time they took to download, unpack and verify. Large NARs take longer, so a slow fetch doesn't always mean a slow cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) ((nix_store_csi_nar_fetch_duration_seconds_bucket{instance=~\"$instance\",result=\"ok\"} - nix_store_csi_nar_fetch_duration_seconds_bucket{instance=~\"$instance\",result=\"ok\"} offset $__interval >= 0) or nix_store_csi_nar_fetch_duration_seconds_bucket{instance=~\"$instance\",result=\"ok\"})",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No fetches"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "NARs in flight",
      "description": "NARs being fetched, by node. --max-substitution-jobs caps it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (nix_store_csi_nar_fetches_in_flight{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "id": 16
    },
    {
      "type": "row",
      "title": "Node store",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": [],
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Store size",
      "description": "NAR size of the node store, by node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (nix_store_csi_store_size_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "id": 18
    },
    {
      "type": "stat",
      "title": "Freed",
      "description": "NAR size of the store objects that collection deleted in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
